# File Paths
# DATASET_DIR=/home/duckq1u/Documents/Aiops-g4/capstone/tf-3/ai/ai-engine/dataset
# GROUND_TRUTH_PATH=/home/duckq1u/Documents/Aiops-g4/capstone/tf-3/ai/ai-engine/dataset/ground_truth.json
# RUNBOOKS_PATH=/home/duckq1u/Documents/Aiops-g4/capstone/tf-3/ai/ai-engine/dataset/runbooks.json

DATASET_DIR=./dataset
GROUND_TRUTH_PATH=./dataset/ground_truth.json
RUNBOOKS_PATH=./dataset/runbooks.json

# Server Configuration
API_HOST=127.0.0.1
API_PORT=8050

# Anomaly Detection Hyperparameters
IFOREST_MULTIVARIATE_THRESHOLD_MULTIPLIER=6.0
IFOREST_UNIVARIATE_THRESHOLD_MULTIPLIER=5.0
EWMA_ALPHA=0.1
EWMA_THRESHOLD=5.0
BASELINE_LENGTH=600

# Correlation & Diagnostics Hyperparameters
CORRELATION_THRESHOLD=0.25
ANALYSIS_WINDOW_SIZE=120

# Root Cause Analysis Engine Option
# Set to True to use BARO (fse-baro) for RCA, or False to use the default Pearson + Z-Score engine
USE_BARO_RCA=True
# Number of top-k root cause candidates to retrieve when using BARO
BARO_TOP_K=3

# Anomaly Detection Engine Option
# Set to True to use Robust Random Cut Forest (RRCF) instead of Isolation Forest (IF)
USE_RRCF=False
# Set to True to use Bayesian Online Change Point Detection (BOCPD) for anomaly detection
USE_BOCPD=True

# RRCF Hyperparameters
RRCF_NUM_TREES=100
RRCF_TREE_SIZE=256
RRCF_MULTIVARIATE_THRESHOLD_MULTIPLIER=6.0
RRCF_UNIVARIATE_THRESHOLD_MULTIPLIER=5.0

# Global Random Seed
RANDOM_STATE=42

# Drain3 Log Parser Configuration
DRAIN_SIM_TH=0.05
DRAIN_DEPTH=4
LOG_ERROR_KEYWORDS=(error|exception|fail|timeout|exhaust|limit|abort|invalid|refused|conn|crash|oom|kill)

# Isolation Forest Core Hyperparameters
IFOREST_CONTAMINATION=0.01
IFOREST_N_ESTIMATORS=100

# RCA Engine Scoring & Weighting Hyperparameters
RCA_ZSCORE_THRESHOLD=2.0
RCA_ZSCORE_MAX_CONTRIBUTION=500.0
RCA_LOG_METRIC_DEFAULT_WEIGHT=1.0
RCA_LOG_METRIC_COLOCATED_WEIGHT=3.0
RCA_LOG_METRIC_MULTIPLIER=25.0
RCA_CONFIDENCE_MAX=0.95
RCA_CONFIDENCE_BASE=0.70
RCA_CONFIDENCE_DIVISOR=200.0
RCA_SMOOTHING_WINDOW=15
RCA_DEVIATION_WINDOW=30

# Alert Correlation & Verification Hyperparameters
ALERT_HEALING_WINDOW_SECONDS=120
VERIFY_ERROR_THRESHOLD=0.05
VERIFY_LATENCY_THRESHOLD=0.5
VERIFY_REGRESSION_ERROR_THRESHOLD=0.10

# BOCPD Evaluation Slicing Hyperparameters
EVAL_BOCPD_WINDOW_BEFORE=80
EVAL_BOCPD_WINDOW_AFTER=30
EVAL_BOCPD_BASELINE_LENGTH=50

# OOP Modular & Configurable Hyperparameters
DEPENDENCY_GRAPH_PATH=./dataset/dependency_graph.json
BOCPD_HAZARD=50
RCA_ANALYSIS_WINDOW_AFTER=10
BARO_RCA_CONFIDENCE=0.90
RCA_STD_REG_MULTIPLIER=0.05
RCA_STD_REG_ADDITIVE=0.05
SERVICES_LIST=checkoutservice,currencyservice,emailservice,productcatalogservice,recommendationservice,adservice,cartservice,frontend,paymentservice,redis,shippingservice
METRIC_TYPES_LIST=cpu,mem,latency,error,socket,diskio

# LLM Decider Configurations
USE_LLM_DECISION=True
LLM_PROVIDER=openai
LLM_MODEL=wtran6321/gpt-5.4-mini

# OpenAI Configurations
OPENAI_API_KEY=sk-58b33338350248cf14a721cfedfd4bf3891b11fb1abc985a71e08fdeaed1587b
OPENAI_API_URL=https://api.xah.io/v1

# Anthropic Configurations
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages

# AWS Bedrock Configurations
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_SESSION_TOKEN=your_aws_session_token_here
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=https://bedrock-runtime.us-east-1.amazonaws.com

