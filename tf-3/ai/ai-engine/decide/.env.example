# Copy to .env. Use port 8052 if 8051 is taken (e.g. by Steam on Windows).
DATASET_DIR=../dataset
GROUND_TRUTH_PATH=../dataset/ground_truth.json
RUNBOOKS_PATH=../dataset/runbooks.json

API_HOST=127.0.0.1
API_PORT=8051

# rule-based (default) or llm
DECIDER_TYPE=rule-based
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_DAILY_CAP_USD=50.0

ALERT_HEALING_WINDOW_SECONDS=120
