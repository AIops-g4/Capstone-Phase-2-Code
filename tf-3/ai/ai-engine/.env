# Dataset path config
DATASET_PATH=/home/duckq1ulaptop/Desktop/aiops-g4/capstone/tf-3/ai/ai-engine/dataset

# Decision engine type: 'rule-based' or 'llm'
DECIDER_TYPE=rule-based

# AWS configurations for Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Hyperparameters for anomaly detection (General thresholds)
ANOMALY_THRESHOLD_CPU=0.80
ANOMALY_THRESHOLD_MEM_MB=150
ANOMALY_THRESHOLD_ERROR_RATE=0.05
ANOMALY_THRESHOLD_LATENCY_P95_MS=1000.0

# Hyperparameters for EWMA Smoothing
EWMA_SPAN=5

# Hyperparameters for Isolation Forest (IF)
IF_CONTAMINATION=0.05
IF_N_ESTIMATORS=100

# Hyperparameters for Drain3 Log Parsing
DRAIN3_SIM_TH=0.4
DRAIN3_DEPTH=4
DRAIN3_MAX_CHILDREN=100
DRAIN3_MAX_CLUSTERS=1000

# Budget and cost control
COST_LIMIT_DAILY=50.0

# Logging
LOG_LEVEL=INFO
