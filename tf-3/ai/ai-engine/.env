# Dataset path config
DATASET_PATH=./dataset

# Topology Graph Path
TOPOLOGY_GRAPH_PATH=./topology_graph.json

# Whether to bypass anomaly detection algorithms and use directory name hints (True/False)
BENCHMARK_USE_HINTS=False

# Decision engine type: 'rule-based' or 'llm'
DECIDER_TYPE=rule-based

# AWS configurations for Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Hyperparameters for anomaly detection (General thresholds)
ANOMALY_THRESHOLD_CPU=0.80
ANOMALY_THRESHOLD_MEM_MB=150
ANOMALY_THRESHOLD_ERROR_RATE=0.05
ANOMALY_THRESHOLD_LATENCY_P95_MS=1000.0

# Hyperparameters for EWMA Smoothing
EWMA_SPAN=5

# Hyperparameters for Isolation Forest (IF)
IF_CONTAMINATION=0.05
IF_N_ESTIMATORS=100

# Hyperparameters for Drain3 Log Parsing
DRAIN3_SIM_TH=0.4
DRAIN3_DEPTH=4
DRAIN3_MAX_CHILDREN=100
DRAIN3_MAX_CLUSTERS=1000

# Specific Detector Thresholds
DETECTOR_Z_THRESHOLD=3.0
DETECTOR_IF_SCALE=15.0
DETECTOR_COMBINED_THRESHOLD=3.0
DETECTOR_BEST_SCORE_THRESHOLD=5.0

# Alert Correlation Parameters
CORRELATION_TIME_WINDOW_SEC=60
CORRELATION_SEMANTIC_WEIGHT=0.7

# Budget and cost control
COST_LIMIT_DAILY=50.0

# Logging
LOG_LEVEL=INFO
