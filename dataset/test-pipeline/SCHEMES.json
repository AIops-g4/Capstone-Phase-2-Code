{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RCAEvalPipelineSchemas",
  "description": "Schemas defining inputs and outputs of the RCA evaluation pipeline.",
  "definitions": {
    "predictions_schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "RCAPredictions",
      "description": "Scores predicted for candidate services across multiple failure cases.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "description": "Mapping of service names to predicted scores. Scores should be between 0.0 and 1.0.",
        "additionalProperties": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "ground_truth_schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "RCAGroundTruth",
      "description": "Ground truth labeling for multiple failure cases, including candidate services.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "root_cause_service": {
            "type": "string",
            "description": "The exact service name that is the root cause of the failure."
          },
          "fault_type": {
            "type": "string",
            "description": "The type of fault injected (e.g., f1, f2, f3, f4, f5)."
          },
          "system": {
            "type": "string",
            "enum": ["OB", "SS", "TT"],
            "description": "The microservice system (Online Boutique, Sock Shop, Train Ticket)."
          },
          "candidate_services": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of all active services in this case, used to define negative labels (0)."
          }
        },
        "required": ["root_cause_service", "fault_type", "system", "candidate_services"],
        "additionalProperties": false
      }
    },
    "metrics_schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "RCAMetrics",
      "description": "Results output by the evaluation pipeline.",
      "type": "object",
      "properties": {
        "evaluation_mode": {
          "type": "string",
          "description": "Description of the split or dataset evaluated (e.g., private_test)."
        },
        "num_cases": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of evaluation cases processed."
        },
        "threshold_based_metrics": {
          "type": "object",
          "properties": {
            "threshold": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "precision": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "recall": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "f1_score": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            }
          },
          "required": ["threshold", "precision", "recall", "f1_score"],
          "additionalProperties": false
        },
        "top1_based_metrics": {
          "type": "object",
          "properties": {
            "precision": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "recall": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "f1_score": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            }
          },
          "required": ["precision", "recall", "f1_score"],
          "additionalProperties": false
        },
        "pr_auc": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Precision-Recall Area Under Curve (computed using Average Precision)."
        }
      },
      "required": ["evaluation_mode", "num_cases", "threshold_based_metrics", "top1_based_metrics", "pr_auc"],
      "additionalProperties": false
    }
  }
}
